{
  "name": "@sinjoh/abis",
  "version": "1.1.1",
  "description": "Generated, viem-typed ABIs for the Sinjoh contracts, harvested from Foundry build output at a pinned source commit.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sinjoh-Finance/sinjoh-sdk.git",
    "directory": "packages/abis"
  },
  "homepage": "https://github.com/Sinjoh-Finance/sinjoh-sdk#readme",
  "bugs": {
    "url": "https://github.com/Sinjoh-Finance/sinjoh-sdk/issues"
  },
  "keywords": [
    "sinjoh",
    "ethereum",
    "abi",
    "viem",
    "robinhood-chain"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "publishConfig": {
    "access": "public"
  }
}
