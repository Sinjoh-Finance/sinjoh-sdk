{
  "name": "@sinjoh/agent",
  "version": "2.2.0",
  "description": "MCP server for Sinjoh public data, contract planning, prepared calls, and optional host-wallet transaction execution.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sinjoh-Finance/sinjoh-sdk.git",
    "directory": "packages/agent"
  },
  "homepage": "https://github.com/Sinjoh-Finance/sinjoh-sdk/tree/main/packages/agent#readme",
  "bugs": {
    "url": "https://github.com/Sinjoh-Finance/sinjoh-sdk/issues"
  },
  "keywords": [
    "sinjoh",
    "mcp",
    "agents",
    "ethereum",
    "robinhood-chain"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "sinjoh-mcp": "dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts && npm run build && node --input-type=module -e 'import(\"./dist/src/server.js\")'"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@sinjoh/deployments": "2.2.0",
    "@sinjoh/sdk": "2.2.0",
    "viem": "2.55.10",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0"
  }
}
