{
  "name": "@sinjoh/deployments",
  "version": "0.0.1",
  "private": true,
  "description": "Typed Sinjoh deployment manifests for Robinhood Chain, generated from the canonical mainnet-deployments.json, with a runtime code-hash verifier.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "viem": ">=2.55.10 <3"
  }
}
