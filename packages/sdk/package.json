{
  "name": "@sinjoh/sdk",
  "version": "2.2.5",
  "description": "Core Sinjoh SDK: byte-exact configuration codecs, launch prediction, and custom-error decoding for the immutable Sinjoh protocols on Robinhood Chain.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sinjoh-Finance/sinjoh-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/Sinjoh-Finance/sinjoh-sdk#readme",
  "bugs": {
    "url": "https://github.com/Sinjoh-Finance/sinjoh-sdk/issues"
  },
  "keywords": [
    "sinjoh",
    "ethereum",
    "sdk",
    "viem",
    "robinhood-chain"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@jsquash/webp": "^1.5.0",
    "@sinjoh/abis": "2.2.5",
    "@sinjoh/deployments": "2.2.5",
    "jpeg-js": "^0.4.4"
  },
  "peerDependencies": {
    "viem": ">=2.55.10 <3"
  },
  "publishConfig": {
    "access": "public"
  }
}
