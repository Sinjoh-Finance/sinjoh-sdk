{
  "name": "@sinjoh/merkle",
  "version": "1.1.1",
  "description": "Deterministic Merkle-sum trees for Sinjoh airdrop epochs and raffle ticket intervals, pinned to the Solidity reference fixtures.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sinjoh-Finance/sinjoh-sdk.git",
    "directory": "packages/merkle"
  },
  "homepage": "https://github.com/Sinjoh-Finance/sinjoh-sdk#readme",
  "bugs": {
    "url": "https://github.com/Sinjoh-Finance/sinjoh-sdk/issues"
  },
  "keywords": [
    "sinjoh",
    "ethereum",
    "merkle-tree",
    "raffle",
    "airdrop"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "viem": ">=2.55.10 <3"
  },
  "publishConfig": {
    "access": "public"
  }
}
